{
  "name": "TokenGuard - LLM Spend Monitor & Slack Alert",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger (Every 5 Mins)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/dashboard/billing/usage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "options": {}
      },
      "id": "http-fetch-usage",
      "name": "Fetch OpenAI Usage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "1",
          "name": "OpenAI Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const usageData = $input.item.json;\n// Mock calculation for MVP TokenGuard check\nconst currentSpend = usageData.total_usage ? usageData.total_usage / 100 : 42.50;\nconst budgetLimit = 50.00;\nconst percentage = (currentSpend / budgetLimit) * 100;\n\nreturn {\n  json: {\n    currentSpend,\n    budgetLimit,\n    percentage,\n    isOverThreshold: percentage >= 80,\n    topDrivers: [\n      { endpoint: \"/v1/chat/completions\", cost: \"$30.00\", note: \"3x more expensive than average\" },\n      { endpoint: \"/v1/embeddings\", cost: \"$8.50\", note: \"High volume requests\" },\n      { endpoint: \"/v1/fine-tuning\", cost: \"$4.00\", note: \"Active training job\" }\n    ]\n  }\n};"
      },
      "id": "code-check-threshold",
      "name": "Check Budget Threshold",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "threshold-check",
              "leftValue": "={{ $json.isOverThreshold }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-over-threshold",
      "name": "Is Spend >= 80%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "post",
        "channel": "#token-alerts",
        "text": "=\ud83d\udea8 *TokenGuard Alert: Budget Warning!* \nYou have reached *{{ $json.percentage.toFixed(1) }}%* of your monthly budget.\n\n\u2022 *Current Spend:* ${{ $json.currentSpend.toFixed(2) }}\n\u2022 *Budget Limit:* ${{ $json.budgetLimit.toFixed(2) }}\n\n*Top 3 Cost Drivers:*\n1. `{{ $json.topDrivers[0].endpoint }}` - {{ $json.topDrivers[0].cost }} (_{{ $json.topDrivers[0].note }}_)\n2. `{{ $json.topDrivers[1].endpoint }}` - {{ $json.topDrivers[1].cost }} (_{{ $json.topDrivers[1].note }}_)\n3. `{{ $json.topDrivers[2].endpoint }}` - {{ $json.topDrivers[2].cost }} (_{{ $json.topDrivers[2].note }}_)\n\n*Recommended Action:* Switch to a cheaper model or batch requests to avoid bill shock.",
        "otherOptions": {}
      },
      "id": "slack-alert",
      "name": "Send Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "slackApi": {
          "id": "2",
          "name": "Slack Account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger (Every 5 Mins)": {
      "main": [
        [
          {
            "node": "Fetch OpenAI Usage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch OpenAI Usage": {
      "main": [
        [
          {
            "node": "Check Budget Threshold",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Budget Threshold": {
      "main": [
        [
          {
            "node": "Is Spend >= 80%?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Spend >= 80%?": {
      "main": [
        [
          {
            "node": "Send Slack Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}